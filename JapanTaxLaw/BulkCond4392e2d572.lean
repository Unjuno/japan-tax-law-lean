namespace JapanTaxLaw.BulkCond4392e2d572.xbfa0fff9ad
def outcome (cond effect : Bool) : Bool := cond && effect
theorem requires_both (c e : Bool) : outcome c e = true → c = true ∧ e = true := by
  intro h
  cases c <;> cases e <;> simp [outcome] at h ⊢

end JapanTaxLaw.BulkCond4392e2d572.xbfa0fff9ad

