import JapanTaxLaw.TaxFinance

/-! Bulk conditional dispatch. Condition and effect unresolved. -/
namespace JapanTaxLaw.BulkCondb9d3e17cb1.xaa731fd92e
def outcome (cond effect : Bool) : Bool := cond && effect
theorem requires_both (c e : Bool) : outcome c e = true → c = true ∧ e = true := by
  intro h
  cases c <;> cases e <;> simp [outcome] at h ⊢

end JapanTaxLaw.BulkCondb9d3e17cb1.xaa731fd92e

