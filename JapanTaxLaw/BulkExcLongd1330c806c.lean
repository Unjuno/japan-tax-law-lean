theorem exclusion_absorbs (i e : Bool) : outcome i e = true → e = false := by
  intro h
  cases i <;> cases e <;> simp [outcome] at h ⊢

end JapanTaxLaw.BulkExcLongd1330c806c.x15aef19a12

