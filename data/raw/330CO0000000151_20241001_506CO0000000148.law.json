{"attached_files_info":null,"law_info":{"law_type":"CabinetOrder","law_id":"330CO0000000151","law_num":"昭和三十年政令第百五十一号","law_num_era":"Showa","law_num_year":30,"law_num_type":"CabinetOrder","law_num_num":"151","promulgation_date":"1955-07-30"},"revision_info":{"law_revision_id":"330CO0000000151_20241001_506CO0000000148","law_type":"CabinetOrder","law_title":"地方揮発油税法施行令","law_title_kana":"ちほうきはつゆぜいほうしこうれい","abbrev":"","category":"国税","updated":"2024-09-11T12:45:11+09:00","amendment_promulgate_date":"2024-03-30","amendment_enforcement_date":"2024-10-01","amendment_enforcement_comment":null,"amendment_scheduled_enforcement_date":null,"amendment_law_id":"506CO0000000148","amendment_law_title":"揮発油税法施行令の一部を改正する政令","amendment_law_title_kana":null,"amendment_law_num":"令和六年政令第百四十八号","amendment_type":"3","repeal_status":"None","repeal_date":null,"remain_in_force":false,"mission":"New","current_revision_status":"CurrentEnforced"},"law_full_text":{"tag":"Law","attr":{"Lang":"ja","Era":"Showa","Year":"30","Num":"151","PromulgateMonth":"7","PromulgateDay":"30","LawType":"CabinetOrder"},"children":[{"tag":"LawNum","attr":{},"children":["昭和三十年政令第百五十一号"]},{"tag":"LawBody","attr":{},"children":[{"tag":"LawTitle","attr":{"Kana":"ちほうきはつゆぜいほうしこうれい","Abbrev":"","AbbrevKana":""},"children":["地方揮発油税法施行令"]},{"tag":"EnactStatement","attr":{},"children":["内閣は、地方道路税法（昭和三十年法律第百四号）の規定に基き、及び同法を実施するため、この政令を制定する。"]},{"tag":"MainProvision","attr":{},"children":[{"tag":"Article","attr":{"Num":"1"},"children":[{"tag":"ArticleCaption","attr":{},"children":["（担保の提供）"]},{"tag":"ArticleTitle","attr":{},"children":["第一条"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["地方揮発油税法（以下「法」という。）第八条第一項又は第二項の規定の適用がある場合において、揮発油税法（昭和三十二年法律第五十五号）第十三条第一項、第二項若しくは第四項の規定により担保を提供する者又は同条第三項後段若しくは同法第十八条第一項の規定により提供を命ぜられた担保を提供する者は、その提供する各担保物又は保証人の保証において、揮発油