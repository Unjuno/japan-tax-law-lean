{"attached_files_info":null,"law_info":{"law_type":"CabinetOrder","law_id":"345CO0000000050","law_num":"昭和四十五年政令第五十号","law_num_era":"Showa","law_num_year":45,"law_num_type":"CabinetOrder","law_num_num":"050","promulgation_date":"1970-04-01"},"revision_info":{"law_revision_id":"345CO0000000050_20010106_412CO0000000307","law_type":"CabinetOrder","law_title":"国税不服審判所組織令","law_title_kana":"こくぜいふふくしんぱんところそしきれい","abbrev":"","category":"行政組織","updated":"2024-07-22T08:45:11+09:00","amendment_promulgate_date":"2000-06-07","amendment_enforcement_date":"2001-01-06","amendment_enforcement_comment":null,"amendment_scheduled_enforcement_date":null,"amendment_law_id":"412CO0000000307","amendment_law_title":null,"amendment_law_title_kana":"","amendment_law_num":"平成十二年政令第三百七号","amendment_type":"3","repeal_status":"None","repeal_date":null,"remain_in_force":false,"mission":"New","current_revision_status":"CurrentEnforced"},"law_full_text":{"tag":"Law","attr":{"Era":"Showa","Lang":"ja","LawType":"CabinetOrder","Num":"050","Year":"45","PromulgateMonth":"04","PromulgateDay":"01"},"children":[{"tag":"LawNum","attr":{},"children":["昭和四十五年政令第五十号"]},{"tag":"LawBody","attr":{},"children":[{"tag":"LawTitle","attr":{"Kana":"こくぜいふふくしんぱんところそしきれい","Abbrev":"","AbbrevKana":""},"children":["国税不服審判所組織令"]},{"tag":"EnactStatement","attr":{},"children":["内閣は、国税通則法（昭和三十七年法律第六十六号）第七十八条第五項の規定に基づき、この政令を制定する。"]},{"tag":"MainProvision","attr":{},"children":[{"tag":"Article","attr":{"Num":"1"},"children":[{"tag":"ArticleCaption","attr":{},"children":["（次長）"]},{"tag":"ArticleTitle","attr":{},"children":["第一条"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{},"children":["国税不服審判所に、次長一人を置き、国税審判官をもつてこれに充てる。"]}]}]},{"tag":"Paragraph","attr":{"Num":"2"},"children":[{"tag":"ParagraphNum","attr":{},"children":["２"]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{},"