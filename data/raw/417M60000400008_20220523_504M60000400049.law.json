{"attached_files_info":{"image_data":"","attached_files":[{"law_revision_id":"417M60000400008_20220523_504M60000400049","src":"./pict/2FH00000048569.pdf","updated":"2024-07-25T01:00:41+09:00"},{"law_revision_id":"417M60000400008_20220523_504M60000400049","src":"./pict/2FH00000048570.pdf","updated":"2024-07-25T01:00:41+09:00"},{"law_revision_id":"417M60000400008_20220523_504M60000400049","src":"./pict/2FH00000048572.pdf","updated":"2024-07-25T01:00:41+09:00"}]},"law_info":{"law_type":"MinisterialOrdinance","law_id":"417M60000400008","law_num":"平成十七年経済産業省令第八号","law_num_era":"Heisei","law_num_year":17,"law_num_type":"MinisterialOrdinance","law_num_num":"008","promulgation_date":"2005-02-25"},"revision_info":{"law_revision_id":"417M60000400008_20220523_504M60000400049","law_type":"MinisterialOrdinance","law_title":"経済連携協定に基づく経済産業省の所掌事務に係る物資の関税割当制度に関する省令","law_title_kana":"けいざいれんけいきょうていにもとづくけいざさんぎょうしょうのしょしょうじむにかかるぶっしのかんぜいわりあてせいどにかんするしょうれい","abbrev":"","category":"国税","updated":"2024-07-22T04:54:46+09:00","amendment_promulgate_date":"2022-05-23","amendment_enforcement_date":"2022-05-23","amendment_enforcement_comment":null,"amendment_scheduled_enforcement_date":null,"amendment_law_id":"504M60000400049","amendment_law_title":"経済連携協定に基づく経済産業省の所掌事務に係る物資の関税割当制度に関する省令の一部を改正する省令","amendment_law_title_kana":null,"amendment_law_num":"令和四年経済産業省令第四十九号","amendment_type":"3","repeal_status":"None","repeal_date":null,"remain_in_force":false,"mission":"New","current_revision_status":"CurrentEnforced"},"law_full_text":{"tag":"Law","attr":{"Era":"Heisei","Lang":"ja","LawType":"MinisterialOrdinance","Num":"008","Year":"17","PromulgateMonth":"02","PromulgateDay":"25"},"children":[{"tag":"LawNum","attr":{},"children":["平成十七年経済産業省令第八号"]},{"tag":"LawBody","attr":{},"children":[{"tag":"LawTitle","attr":{"Kana":"けいざいれんけいきょうていにもとづくけいざさんぎょうしょうのしょしょうじむにかかるぶっしのかんぜいわりあてせいどにかんするしょうれい","Abbrev":"","AbbrevKana":""},"children":["経済連携協定に基づく経済産業省の所掌事務に係る物資の関税割当制度に関する省令"]},{"tag":"EnactStatement","attr":{},"children":["経済上の連携の強化に関する日本国とメキシコ合衆国との間の協定に基づく関税割当制度に関する政令（平成十七年政令第三十五号）第一条第十一項の規定に基づき、経済上の連携の強化に関する日本国とメキシコ合衆国との間の協定に基づく経済産業省の所掌事務に係る物資の関税割当制度に関する省令を次のように制定する。"]},{"tag":"MainProvision","attr":{},"children":[{"tag":"Article","attr":{"Num":"1"},"children":[{"tag":"ArticleCaption","attr":{},"children":["（関税割当申請書）"]},{"tag":"ArticleTitle","attr":{},"children":["第一条"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["経済連携協定に基づく関税割当制度に関する政令（平成十七年政令第三十五号。以下「令」という。）第二条第一項及び第二項に規定する関税割当申請書の様式は、様式第一によるものとし、その提出部数は、一通とする。"]}]}]}]},{"tag":"Article","attr":{"Num":"2"},"children":[{"tag":"ArticleCaption","attr":{},"children":["（関税割当証明書）"]},{"tag":"ArticleTitle","attr":{},"children":["第二条"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["令第二条第七項に規定する関税割当証明書（以下「証明書」という。）の様式は、様式第二によるものとする。"]}]}]}]},{"tag":"Article","attr":{"Num":"3"},"children":[{"tag":"ArticleTitle","attr":{},"children":["第三条"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["削除"]}]}]}]},{"tag":"Article","attr":{"Num":"4"},"children":[{"tag":"ArticleCaption","attr":{},"children":["（証明書の分割）"]},{"tag":"ArticleTitle","attr":{},"children":["第四条"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["令第二条第五項及び第六項の規定により割当てを受けた者がその割当数量（この条の規定により分割された割当数量を含む。）を分割し、その分割した数量に応じて証明書（この条の規定により分割された証明書を含む。以下同じ。）の分割を申請しようとするときは、様式第四による関税割当証明書分割申請書一通に当該証明書を添えて、経済産業大臣に提出しなければならない。"]}]}]},{"tag":"Paragraph","attr":{"Num":"2"},"children":[{"tag":"ParagraphNum","attr":{},"children":["２"]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["経済産業大臣は、前項の申請書を受理した場合において、分割の必要があると認めるときは、分割した証明書を交付するものとする。"]}]}]}]},{"tag":"Article","attr":{"Num":"5"},"children":[{"tag":"ArticleCaption","attr":{},"children":["（証明書の返納）"]},{"tag":"ArticleTitle","attr":{},"children":["第五条"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["令第二条第五項及び第六項の規定により割当てを受けた者は、当該割当数量又はその残存数量（割当数量から割当てに係る貨物の輸入数量を差し引いた数量をいう。）に係る貨物の輸入を希望しなくなったとき、又は証明書の有効期間が満了したときその他当該貨物の輸入をすることができなくなったときは、遅滞なく、当該証明書を経済産業大臣に返納しなければならない。"]}]}]}]},{"tag":"Article","attr":{"Num":"6"},"children":[{"tag":"ArticleCaption","attr":{},"children":["（公表）"]},{"tag":"ArticleTitle","attr":{},"children":["第六条"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["経済産業大臣は、前各条に規定するもののほか、関税割当申請書の提出の時期及び提出先、添付書類その他手続に関し必要な事項並びに割当ての基準に関する事項を定めて公表するものとする。"]}]}]}]}]},{"tag":"SupplProvision","attr":{},"children":[{"tag":"SupplProvisionLabel","attr":{},"children":["附　則"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["この省令は、関税暫定措置法の一部を改正する法律（平成十六年法律第百四十二号）の施行の日から施行する。"]}]}]}]},{"tag":"SupplProvision","attr":{"AmendLawNum":"平成一九年三月三一日経済産業省令第三一号"},"children":[{"tag":"SupplProvisionLabel","attr":{},"children":["附　則"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"Para