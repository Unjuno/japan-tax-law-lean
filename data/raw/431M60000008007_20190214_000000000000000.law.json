{"attached_files_info":null,"law_info":{"law_type":"MinisterialOrdinance","law_id":"431M60000008007","law_num":"平成三十一年総務省令第七号","law_num_era":"Heisei","law_num_year":31,"law_num_type":"MinisterialOrdinance","law_num_num":"007","promulgation_date":"2019-02-14"},"revision_info":{"law_revision_id":"431M60000008007_20190214_000000000000000","law_type":"MinisterialOrdinance","law_title":"平成三十年度分の地方交付税の交付時期及び交付額の特例に関する省令","law_title_kana":"へいせいさんじゅうねんどぶんのちほうこうふぜいのこうふじきおよびこうふがくのとくれいにかんするしょうれい","abbrev":"","category":"地方財政","updated":"2024-07-21T23:26:41+09:00","amendment_promulgate_date":"2019-02-14","amendment_enforcement_date":"2019-02-14","amendment_enforcement_comment":null,"amendment_scheduled_enforcement_date":null,"amendment_law_id":null,"amendment_law_title":"","amendment_law_title_kana":"","amendment_law_num":null,"amendment_type":"1","repeal_status":"None","repeal_date":null,"remain_in_force":false,"mission":"New","current_revision_status":"CurrentEnforced"},"law_full_text":{"tag":"Law","attr":{"Era":"Heisei","Lang":"ja","LawType":"MinisterialOrdinance","Num":"007","Year":"31","PromulgateMonth":"02","PromulgateDay":"14"},"children":[{"tag":"LawNum","attr":{},"children":["平成三十一年総務省令第七号"]},{"tag":"LawBody","attr":{},"children":[{"tag":"LawTitle","attr":{"Kana":"へいせいさんじゅうねんどぶんのちほうこうふぜいのこうふじきおよびこうふがくのとくれいにかんするしょうれい","Abbrev":"","AbbrevKana":""},"children":["平成三十年度分の地方交付税の交付時期及び交付額の特例に関する省令"]},{"tag":"EnactStatement","attr":{},"children":["地方交付税法（昭和二十五年法律第二百十一号）第十六条第二項の規定に基づき、平成三十年度分の地方交付税の交付時期及び交付額の特例に関する省令を次のように定める。"]},{"tag":"MainProvision","attr":{},"children":[{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{},"children":["地方交付税法第十六条第一項の規定にかかわらず、各地方団体に対して交付すべき平成三十年度分の地方交付税の額のうち、同法、平成三十年度分として交付すべき地方交付税の総額の特例に関する法律（平成三十一年法律第一号）及び普通交付税に関する省令（昭和三十七年自治省令第十七号）の規定により交付すべき普通交付税の額から、既に交付した普通交付税の額を控除した額を平成三十一年二月において交付する。"]}]}]}]},{"tag":"SupplProvision","attr":{"Extract":"false","Type":"New"},"children":[{"tag":"SupplProvisionLabel","attr":{},"children":["附　則"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{},"children":["この省令は、公布の日から施行する。"]}]}]}]}]}]}}