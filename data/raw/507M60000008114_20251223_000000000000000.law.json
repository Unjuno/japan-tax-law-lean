{"attached_files_info":null,"law_info":{"law_type":"MinisterialOrdinance","law_id":"507M60000008114","law_num":"令和七年総務省令第百十四号","law_num_era":"Reiwa","law_num_year":7,"law_num_type":"MinisterialOrdinance","law_num_num":"114","promulgation_date":"2025-12-23"},"revision_info":{"law_revision_id":"507M60000008114_20251223_000000000000000","law_type":"MinisterialOrdinance","law_title":"令和七年度分の地方交付税の交付額の特例に関する省令","law_title_kana":"れいわしちねんどぶんのちほうこうふぜいのこうふがくのとくれいにかんするしょうれい","abbrev":"","category":"地方財政","updated":"2026-01-13T09:46:04+09:00","amendment_promulgate_date":"2025-12-23","amendment_enforcement_date":"2025-12-23","amendment_enforcement_comment":null,"amendment_scheduled_enforcement_date":null,"amendment_law_id":null,"amendment_law_title":null,"amendment_law_title_kana":null,"amendment_law_num":null,"amendment_type":"1","repeal_status":"None","repeal_date":null,"remain_in_force":false,"mission":"New","current_revision_status":"CurrentEnforced"},"law_full_text":{"tag":"Law","attr":{"Lang":"ja","Era":"Reiwa","Year":"07","Num":"114","PromulgateMonth":"12","PromulgateDay":"23","LawType":"MinisterialOrdinance"},"children":[{"tag":"LawNum","attr":{},"children":["令和七年総務省令第百十四号"]},{"tag":"LawBody","attr":{},"children":[{"tag":"LawTitle","attr":{"Kana":"れいわしちねんどぶんのちほうこうふぜいのこうふがくのとくれいにかんするしょうれい","Abbrev":"","AbbrevKana":""},"children":["令和七年度分の地方交付税の交付額の特例に関する省令"]},{"tag":"EnactStatement","attr":{},"children":["地方交付税法（昭和二十五年法律第二百十一号）第十六条第二項の規定に基づき、令和七年度分の地方交付税の交付額の特例に関する省令を次のように定める。"]},{"tag":"MainProvision","attr":{},"children":[{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["令和七年十二月において各地方団体に対して交付すべき地方交付税の額は、地方交付税法第十六条第一項の規定にかかわらず、同項の規定により十二月に交付すべき額に令和七年度において各地方団体に対して交付すべき普通交付税の額から既に交付した普通交付税の額を控除した額を加算した額とする。"]}]}]}]},{"tag":"SupplProvision","attr":{},"children":[{"tag":"SupplProvisionLabel","attr":{},"c